<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 动态时间背景 -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 彻底移除背景发光 -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 隐藏原版半空悬浮的 heroName，统一由 App 卡片下方展示名称 -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- 1. 右上角极简状态栏胶囊 (Wi-Fi, 设置) -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnInputs"
            style="@style/TopButton"
            android:text="@string/inputs"
            android:drawableStart="@drawable/ic_input"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/TopButton"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/wifi"
            android:drawableStart="@drawable/ic_wifi"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:text="@string/settings"
            android:drawableStart="@drawable/ic_settings"
            android:nextFocusDown="@+id/grid" />
    </LinearLayout>

    <!-- 2. 用户红框指定区域：大号加粗沉浸式时钟与日期展示区 -->
    <LinearLayout
        android:id="@+id/leftBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="68dp"
        android:layout_marginTop="100dp"
        android:orientation="vertical">

        <!-- 问候语 -->
        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#A6FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <!-- 加大加粗大时钟 (88sp, 粗体, 纯白) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:layout_marginTop="4dp">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="88sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="12dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#CCFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit_medium"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- 完整日期与星期展示 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/shamsiDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_regular"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 下半部分：两行完整展示的应用网格区 (固定高度，确保第二行不被截断) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="290dp"
        android:paddingStart="56dp"
        android:paddingEnd="56dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>

    <!-- 隐去生硬的浮层 highlight -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>

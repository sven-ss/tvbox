<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 动态时间天空背景 -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 彻底移除背景发光 -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 隐藏原版半空悬浮的 heroName，统一由 App 卡片下方展示名称 -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- 1. 左上角原位：保留问候语与日期星期 -->
    <LinearLayout
        android:id="@+id/headerDateBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="56dp"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#A6FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.18"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/shamsiDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_regular"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#D9FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.1"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. 右上角原位：极简状态栏胶囊 (Wi-Fi, 设置) -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnInputs"
            style="@style/TopButton"
            android:text="@string/inputs"
            android:drawableStart="@drawable/ic_input"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/TopButton"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/wifi"
            android:drawableStart="@drawable/ic_wifi"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:text="@string/settings"
            android:drawableStart="@drawable/ic_settings"
            android:nextFocusDown="@+id/grid" />
    </LinearLayout>

    <!-- 3. 用户红框指定位置：仅放置加大加粗的大时钟 -->
    <LinearLayout
        android:id="@+id/leftBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="68dp"
        android:layout_marginTop="105dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="96sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextClock
            android:id="@+id/ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:format12Hour="a"
            android:format24Hour=""
            android:textColor="#B3FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit_medium"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- 4. 下半部分：两行完整展示的应用网格区 (高度充裕，第二行完整呈现) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="280dp"
        android:paddingStart="56dp"
        android:paddingEnd="56dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>

    <!-- 隐去生硬的浮层 highlight -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>

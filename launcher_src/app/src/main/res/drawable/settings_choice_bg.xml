<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态：Apple tvOS 标志性的白底悬浮高光药丸卡片 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 选中未聚焦状态：Apple tvOS 标志性的微透高亮轮廓 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 默认未聚焦状态：半透明深色黑曜石毛玻璃材质 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
